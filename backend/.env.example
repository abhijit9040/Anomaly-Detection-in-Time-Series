# ══════════════════════════════════════════════
# Anomaly Detection — Backend Environment
# ══════════════════════════════════════════════

# Application
APP_ENV=development
DEBUG=true
API_VERSION=v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model
MODEL_PATH=../training/artifacts/lstm_autoencoder.pt
SCALER_PATH=../training/artifacts/scaler.pkl
THRESHOLD_PATH=../training/artifacts/threshold.json

# Auth (change in production!)
SECRET_KEY=change-me-in-production-use-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
